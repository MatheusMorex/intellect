generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Autenticação (Better Auth format)
// ============================================================

model User {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  email             String    @unique
  emailVerified     Boolean   @default(false) @map("email_verified")
  image             String?
  username          String?   @unique
  bio               String    @default("")
  timezone          String    @default("America/Sao_Paulo")
  locale            String    @default("pt-BR")
  theme             String    @default("system")
  preferences       Json      @default("{}")
  twoFactorEnabled  Boolean   @default(false) @map("two_factor_enabled")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  sessions          Session[]
  accounts          Account[]
  workspaceMembers  WorkspaceMember[]
  boardsCreated     Board[]           @relation("BoardCreatedBy")
  boardMembers      BoardMember[]
  boardStars        BoardStar[]
  boardVisits       BoardVisit[]
  cardsCreated      Card[]            @relation("CardCreatedBy")
  cardMembers       CardMember[]
  attachments       Attachment[]
  comments          Comment[]
  customFieldCreator CustomField[]    @relation("CustomFieldCreatedBy")
  notifications     Notification[]
  invitesCreated    Invite[]          @relation("InviteCreatedBy")
  boardStarsUser    BoardStar[]       @relation("UserStars")

  @@map("users")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @db.Uuid @map("user_id")
  accountId         String    @map("account_id")
  providerId        String    @map("provider_id")
  accessToken       String?   @map("access_token")
  refreshToken      String?   @map("refresh_token")
  idToken           String?    @map("id_token")
  accessTokenExpiresAt DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope             String?
  password          String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("verifications")
}

model TwoFactor {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @unique @db.Uuid @map("user_id")
  secret    String
  backupCodes String
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factors")
}

// ============================================================
// Workspace e Kanban
// ============================================================

model Workspace {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String    @db.Text
  slug            String    @unique
  description     String    @default("")
  logoUrl         String?   @map("logo_url")
  allowedEmailDomain String? @map("allowed_email_domain")
  settings        Json      @default("{}")
  createdBy       String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  creator         User?     @relation("WorkspaceCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  members         WorkspaceMember[]
  boards          Board[]
  invites         Invite[]
  dashboards      Dashboard[]
  adConnections   AdConnection[]
  salesIntegrations SalesIntegration[]

  @@map("workspaces")
}

model WorkspaceMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @db.Uuid @map("workspace_id")
  userId    String   @db.Uuid @map("user_id")
  role      String   @default("normal")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model Board {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String    @db.Uuid @map("workspace_id")
  name            String
  description     String    @default("")
  background      Json      @default("{\"type\":\"color\",\"value\":\"purple\"}")
  visibility      String    @default("workspace")
  prefs           Json      @default("{}")
  nextCardNumber  Int       @default(1) @map("next_card_number")
  closedAt        DateTime? @map("closed_at")
  createdBy       String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator         User?     @relation("BoardCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  members         BoardMember[]
  stars           BoardStar[]
  visits          BoardVisit[]
  lists           List[]
  cards           Card[]
  labels           Label[]
  invites         Invite[]
  automations     Automation[]

  @@map("boards")
}

model BoardMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boardId   String   @db.Uuid @map("board_id")
  userId    String   @db.Uuid @map("user_id")
  role      String   @default("normal")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@map("board_members")
}

model BoardStar {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  boardId   String   @db.Uuid @map("board_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation("UserStars", fields: [userId], references: [id], onDelete: Cascade)
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([userId, boardId])
  @@map("board_stars")
}

model BoardVisit {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  boardId   String   @db.Uuid @map("board_id")
  visitedAt DateTime @default(now()) @map("visited_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([userId, boardId])
  @@map("board_visits")
}

model Invite {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @db.Uuid @map("workspace_id")
  boardId     String?   @db.Uuid @map("board_id")
  email       String?
  role        String
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime   @map("expires_at")
  maxUses     Int?      @map("max_uses")
  usedCount   Int       @default(0) @map("used_count")
  createdBy   String?   @map("created_by") @db.Uuid
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  board       Board?    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  creator     User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@map("invites")
}

model List {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boardId   String   @db.Uuid @map("board_id")
  name      String
  rank      String   @db.Text // fractional indexing
  color     String?
  archivedAt DateTime? @map("archived_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     Card[]

  @@map("lists")
}

model Card {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boardId           String    @db.Uuid @map("board_id")
  listId            String    @db.Uuid @map("list_id")
  number            Int       @map("number")
  name              String
  description       Json?     @// Tiptap document
  descriptionText   String    @default("") @map("description_text")
  rank              String    @db.Text // fractional indexing
  startAt           DateTime? @map("start_at")
  dueAt             DateTime? @map("due_at")
  dueComplete       Boolean   @default(false) @map("due_complete")
  dueReminderMins   Int?      @map("due_reminder_minutes")
  dueRecurrence     String?   @map("due_recurrence")
  cover             Json?
  version           Int       @default(1)
  createdBy         String?   @map("created_by") @db.Uuid
  lastActivityAt    DateTime  @default(now()) @map("last_activity_at")
  archivedAt        DateTime? @map("archived_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  board             Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  list              List      @relation(fields: [listId], references: [id], onDelete: Cascade)
  creator           User?     @relation("CardCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  members           CardMember[]
  labels            CardLabel[]
  checklists        Checklist[]
  attachments       Attachment[]
  comments          Comment[]
  customFieldValues CustomFieldValue[]
  notifications     Notification[]
  automationRuns    AutomationRun[]
  links             CardLink[]

  @@map("cards")
}

model CardMember {
  id        String   @id @default(dbgenerated("gen_//_random_uuid()")) @db.Uuid
  cardId    String   @db.Uuid @map("card_id")
  userId    String   @db.Uuid @map("user_id")
  createdAt DateTime  @default(now()) @map("created_at")

  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cardId, userId])
  @@map("card_members")
}

model Label {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boardId   String   @db.Uuid @map("board_id")
  name      String   @default("")
  color     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     CardLabel[]

  @@map("labels")
}

model CardLabel {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardId    String   @db.Uuid @map("card_id")
  labelId   String   @db.Uuid @map("label_id")
  createdAt DateTime @default(now()) @map("created_at")

  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label     Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([cardId, labelId])
  @@map("card_labels")
}

model Checklist {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardId    String   @db.Uuid @map("card_id")
  name      String
  rank      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  items     ChecklistItem[]

  @@map("checklists")
}

model ChecklistItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checklistId String  @db.Uuid @map("checklist_id")
  name      String
  rank      String   @db.Text
  completedAt DateTime? @map("completed_at")
  dueAt     DateTime? @map("due_at")
  assigneeId String?  @map("assignee_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  assignee  User?     @relation("ChecklistItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@map("checklist_items")
}

model Attachment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardId    String   @db.Uuid @map("card_id")
  uploaderId String?  @map("uploader_id") @db.Uuid
  kind      String   // 'file' | 'link'
  name      String
  url       String?
  storageKey String? @map("storage_key")
  bytes     BigInt?
  mimeType  String?  @map("mime_type")
  createdAt DateTime @// default(now()) @map("created_at")

  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  uploader  User?    @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  @@map("attachments")
}

model Comment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardId    String   @db.Uuid @map("card_id")
  authorId  String?   @map("author_id") @db.Uuid
  body      Json
  bodyText  String   @map("body_text")
  editedAt  DateTime? @map("edited_at")
  createdAt DateTime @default(now()) @map("created_at")

  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@map("comments")
}

model CustomField {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boardId   String   @db.Uuid @map("board_id")
  name      String
  type      String   // 'text' | 'number' | 'date' | 'checkbox' | 'list'
  options   Json     @default("[]")
  showOnFront Boolean @default(false) @map("show_on_front")
  rank      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  values    CustomFieldValue[]
  creator   User?    @relation("CustomFieldCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdBy String?   @map("created_by") @db.Uuid

  @@map("custom_fields")
}

model CustomFieldValue {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardId    String   @db.Uuid @map("card_id")
  fieldId   String   @db.Uuid @map("field_id")
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  field     CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([cardId, fieldId])
  @@map("custom_field_values")
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  type      String   // 'mention', 'assigned', etc.
  boardId   String?  @map("board_id") @db.Uuid
  cardId    String?  @map("card_id") @db.Uuid
  actorId   String?   @map("actor_id") @db.Uuid
  data      Json      @default("{}")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  board     Board?    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  card      Card?     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@map("notifications")
}

// ============================================================
// Tracking
// ============================================================

model Dashboard {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String    @db.Uuid @map("workspace_id")
  name               String
  timezone           String    @default("America/Sao_Paulo")
  currency           String    @db.Char(3) @default("BRL")
  revenueBasis      String    @default("net") @map("revenue_basis")
  includeInterest    Boolean   @default(false) @map("include_interest")
  revenueGoalCents   BigInt?   @map("revenue_goal_cents")
  adPlatforms       String[]  @default([]) @map("ad_platforms")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  createdBy         String?   @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator           User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  adAccounts        DashboardAdAccount[]
  stores            DashboardStore[]
  costSettings      CostSetting[]
  additionalFees    AdditionalFee[]
  expenses          CustomExpense[]
  integrationTests  IntegrationTest[]
  cardLinks         CardLink[]

  @@map("dashboards")
}

model AdConnection {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String    @db.Uuid @map("workspace_id")
  provider          String    // 'meta' | 'google'
  externalUserId    String    @map("external_user_id")
  externalUserName  String?   @map("external_user_name")
  accessTokenEnc   Bytes     @map("access_token_enc")
  refreshTokenEnc   Bytes?    @map("refresh_token_enc")
  tokenExpiresAt    DateTime? @map("token_expires_at")
  scopes            String[]  @default([])
  status            String    @default("active")
  lastError         String?   @map("last_error")
  createdBy         String?   @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator           User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  adAccounts        AdAccount[]

  @@unique([workspaceId, provider, externalUserId])
  @@map("ad_connections")
}

model AdAccount {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String    @db.Uuid @map("workspace_id")
  connectionId    String?   @db.Uuid @map("connection_id")
  provider        String
  externalId       String    @map("external_id")
  name            String
  currency        String    @db.Char(3)
  timezone        String
  status          String    @default("active")
  syncEnabled     Boolean   @default(false) @map("sync_enabled")
  lastSyncedAt    DateTime? @map("last_synced_at")
  lastSyncError   String?   @map("last_sync_error")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection      AdConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  campaigns       Campaign[]
  insightsDaily   AdInsightDaily[]
  hourlyInsights  AdAccountInsightHourly[]
  dashboardAccs   DashboardAdAccount[]

  @@unique([workspaceId, provider, externalId])
  @@map("ad_accounts")
}

model DashboardAdAccount {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dashboardId    String   @db.Uuid @map("dashboard_id")
  adAccountId    String   @db.Uuid @map("ad_account_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  dashboard     Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  adAccount     AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)

  @@unique([dashboardId, adAccountId])
  @@map("dashboard_ad_accounts")
}

model Campaign {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adAccountId       String    @db.Uuid @map("ad_account_id")
  externalId        String    @map("external_id")
  name              String
  status            String
  statusRaw         String?   @map("status_raw")
  objective         String?
  channelType       String?   @map("channel_type")
  dailyBudgetCents  BigInt?   @map("daily_budget_cents")
  lifetimeBudgetCents BigInt?   @map("lifetime_budget_cents")
  bidStrategy       String?   @map("bid_strategy")
  targetCpaCents    BigInt?   @map("target_cpa_cents")
  remoteUpdatedAt   DateTime? @map("remote_updated_at")
  syncedAt          DateTime  @default(now()) @map("synced_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  adAccount        AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  adSets            AdSet[]
  ads               Ad[]
  insightsDaily    AdInsightDaily[]
  cardLinks        CardLink[]

  @@unique([adAccountId, externalId])
  @@map("campaigns")
}

model AdSet {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adAccountId       String    @db.Uuid @map("ad_account_id")
  campaignId        String    @db.Uuid @map("campaign_id")
  externalId        String    @map("external_id")
  name              String
  status            String
  statusRaw         String?   @map("status_raw")
  dailyBudgetCents  BigInt?   @map("daily_budget_cents")
  bidAmountCents    BigInt?   @map("bid_amount_cents")
  spendMinCents     BigInt?   @map("spend_min_cents")
  spendMaxCents     BigInt?   @map("spend_max_cents")
  syncedAt          DateTime  @default(now()) @map("synced_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  adAccount         AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  campaign          Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ads              Ad[]
  insightsDaily    AdInsightDaily[]
  cardLinks        CardLink[]

  @@unique([adAccountId, externalId])
  @@map("ad_sets")
}

model Ad {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adAccountId       String    @db.Uuid @map("ad_account_id")
  campaignId        String    @db.Uuid @map("campaign_id")
  adSetId           String    @db.Uuid @map("ad_set_id")
  externalId        String    @map("external_id")
  name              String
  status            String
  statusRaw         String?   @map("status_raw")
  syncedAt          DateTime  @default(now()) @map("synced_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  adAccount         AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  campaign          Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adSet             AdSet     @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  insightsDaily     AdInsightDaily[]
  cardLinks        CardLink[]

  @@unique([adAccountId, externalId])
  @@map("ads")
}

model Keyword {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adAccountId       String    @db.Uuid @map("ad_account_id")
  campaignId        String    @db.Uuid @map("campaign_id")
