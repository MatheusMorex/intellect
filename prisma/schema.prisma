model Automation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boardId         String    @db.Uuid @map("board_id")
  type            String    // 'rule', 'scheduled', 'due_date', 'card_button', 'board_button', 'metric'
  name            String
  trigger         Json
  actions         Json
  enabled         Boolean   @default(true)
  timezone        String    @default("America/Sao_Paulo")
  nextRunAt       DateTime? @map("next_run_at")
  dashboardId     String?   @db.Uuid @map("dashboard_id")
  createdBy       String?   @map("created_by") @db.Uuid
  failureCount    Int       @default(0) @map("failure_count")
  disabledReason String?   @map("disabled_reason")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  board           Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  dashboard       Dashboard? @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  creator         User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  runs            AutomationRun[]

  @@map("automations")
}

model Activity {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String    @db.Uuid @map("workspace_id")
  boardId              String?   @db.Uuid @map("board_id")
  cardId               String?   @db.Uuid @map("card_id")
  actorId              String?   @// map("actor_id") @db.Uuid
  actorKind            String    @default("user") @map("actor_kind")
  automationRunId     String?   @map("automation_run_id") @db.Uuid
  type                 String
  data                 Json      @default("{}")
  automationCheckedAt DateTime? @map("automation_checked_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  board               Board?    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  card                Card?     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user                User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  automationRun       AutomationRun? @relation(fields: [automationRunId], references: [id], onDelete: SetNull)

  @@map("activities")
}

model AutomationRun {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  automationId      String    @db.Uuid @map("automation_id")
  triggerActivityId String?   @db.Uuid @map("trigger_activity_id")
  cardId            String?   @db.Uuid @map("card_id")
  status            String    @default("running")
  dedupeKey         String?   @map("dedupe_key")
  depth             Int       @default(0)
  message           String?
  operations        Int       @default(0)
  startedAt         DateTime  @default(now()) @map("started_at")
  finishedAt        DateTime? @map("finished_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  automation       Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  activities       Activity[]
  card             Card?      @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@unique([automationId, dedupeKey])
  @@map("automation_runs")
}

model CardLink {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardId        String    @db.Uuid @map("card_id")
  dashboardId   String    @db.Uuid @map("dashboard_id")
