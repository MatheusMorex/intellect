        </PopoverContent>
      </Popover>

      <DropdownMenu>
        <DropdownMenuTrigger asChild>
          <Button variant="outline">Ações da lista</Button>
        </DropdownMenuTrigger>
        <DropdownMenuContent className="w-56" align="start">
          <DropdownMenuLabel>Lista A fazer</DropdownMenuLabel>
          <DropdownMenuItem>
            <Plus aria-hidden="true" />
            Adicionar card
            <DropdownMenuShortcut>N</DropdownMenuShortcut>
          </DropdownMenuItem>
          <DropdownMenuItem>
            <Copy aria-hidden="true" />
            Copiar lista
          </DropdownMenuItem>
          <DropdownMenuItem>
            <MoveRight aria-hidden="true" />
            Mover lista
          </DropdownMenuItem>
          <DropdownMenuItem disabled>Ordenar por prazo</DropdownMenuItem>
          <DropdownMenuSeparator />
          <DropdownMenuItem variant="destructive">
