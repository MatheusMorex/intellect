// Controles da prancha: tema, modo para daltônicos e reduzir animações.
// ?tema=dark e ?daltonicos=1 na URL servem para as capturas de conferência.
export function DesignControls() {
  const { setTheme } = useTheme();
  const urlColorblind = useSyncExternalStore(
    noop,
    () => new URLSearchParams(window.location.search).get("daltonicos") === "1",
    () => false,
  );
  const [colorblindChoice, setColorblind] = useState<boolean | null>(null);
  const [reduced, setReduced] = useState(false);
  const colorblind = colorblindChoice ?? urlColorblind;

  useEffect(() => {
    const tema = new URLSearchParams(window.location.search).get("tema");
    if (tema === "light" || tema === "dark" || tema === "system") setTheme(tema);
  }, [setTheme]);

  useEffect(() => {
    document.documentElement.dataset.colorblind = colorblind ? "on" : "off";
  }, [colorblind]);

  useEffect(() => {
    if (reduced) document.documentElement.dataset.motion = "reduced";
    else delete document.documentElement.dataset.motion;
  }, [reduced]);

  return (
    <div className="flex flex-wrap items-center gap-4">
      <ThemeSwitcher />
      <Label className="font-normal">
        <Switch checked={colorblind} onCheckedChange={setColorblind} />
        Daltônicos
      </Label>
      <Label className="font-normal">
        <Switch checked={reduced} onCheckedChange={setReduced} />
        Reduzir animações
      </Label>
    </div>
  );
}

// Popover, menu, janelas, painel lateral e toasts.
