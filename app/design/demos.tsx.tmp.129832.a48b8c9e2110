        </DialogTrigger>
        <DialogContent className="sm:max-w-[560px]">
          <DialogHeader>
            <DialogTitle>Criar quadro</DialogTitle>
            <DialogDescription>O quadro nasce no workspace INtellect e só os membros veem.</DialogDescription>
          </DialogHeader>
          <div className="grid gap-2">
            <Label htmlFor="novo-quadro">Nome do quadro (obrigatório)</Label>
            <Input id="novo-quadro" placeholder="Ex.: Lançamento de novembro" />
          </div>
          <fieldset className="grid gap-2">
            <legend className="mb-2 text-sm font-medium">Fundo</legend>
            <RadioGroup defaultValue="purple" className="flex flex-wrap gap-2" aria-label="Fundo do quadro">
              {LABEL_HUES.map((hue) => (
                <Label
                  key={hue}
                  className="relative h-8 w-12 cursor-pointer rounded-md has-[:checked]:ring-2 has-[:checked]:ring-ring has-[:checked]:ring-offset-2 has-[:checked]:ring-offset-background"
